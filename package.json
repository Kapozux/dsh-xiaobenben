{
  "name": "dsh-agent-year",
  "version": "0.1.0",
  "description": "Agent 年度回顾：在 DeepSeek Harness 里看过去一年你和各个 coding agent 一起做了什么、说了什么，导出分享图。统计和原话在本机算；AI 部分点了才跑、先报价。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "!src/client",
    "desktop/**",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown --config tsdown.client.config.js",
    "test": "TZ=Asia/Taipei node --test \"tests/*.test.js\"",
    "prepack": "npm run build",
    "check:local": "node scripts/check-local.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "year-in-review",
    "agent"
  ],
  "author": "Kapozux",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "tsdown": "^0.23.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
